# ------------------------------
# .gitignore for FSCRE Paper
# ------------------------------

# Ignore the temporary test results directory
test_results/

# Ignore the full simulation results directory
results/

# Ignore all downloaded application datasets and cached models
data/*.rds
data/*.rda

# Ignore SLURM array runner and bash scripts
R/Generate_Results_Array.R
R/Generate_CPU_Results_Array.R
R/Generate_Sensitivity_Results_Array.R
run_fscre_sims.sh
*.sh

# Ignore SLURM output/error log directories
sim_study_out/
sim_study_err/

# Ignore generic SLURM logs
*.out
*.err
slurm-*.out

# Ignore R history, workspace, and user-specific files
.Rhistory
.RData
.Ruserdata
.Rproj.user/
.Rapp.history

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db